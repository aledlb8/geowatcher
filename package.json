{
  "name": "geowatcher",
  "version": "0.1.0",
  "private": true,
  "description": "Watches Geometry Dash streams on Twitch and alerts you when someone gets far on a real attempt.",
  "license": "MIT OR Apache-2.0",
  "author": "Alejandro de la Blanca",
  "repository": {
    "type": "git",
    "url": "https://github.com/aledlb8/geowatcher.git"
  },
  "bugs": {
    "url": "https://github.com/aledlb8/geowatcher/issues"
  },
  "homepage": "https://github.com/aledlb8/geowatcher#readme",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "build:web": "tsc && vite build",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "doctor": "tauri info",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "verify": "npm run check && npm run typecheck && npm run rust:fmt:check && npm run rust:clippy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
