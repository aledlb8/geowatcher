# Normalise to LF in the repository and the working tree. Without this, a
# checkout on Windows would give CRLF to the shell steps in the CI workflows,
# which fail on the Linux and macOS runners.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated; collapse in review and exclude from language statistics.
package-lock.json linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff
